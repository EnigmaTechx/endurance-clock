{
  "name": "endurance-clock",
  "version": "1.0.0",
  "description": "A web clock themed on the Endurance from Interstellar: a 2D SVG component and an embeddable Three.js 3D widget.",
  "homepage": "https://clock.enigmatech.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EnigmaTechx/endurance-clock.git"
  },
  "keywords": ["clock", "interstellar", "endurance", "three", "webgl", "svg"],
