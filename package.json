  "exports": {
    "./3d": "./3d/js/endurance-clock-3d.js",
    "./3d/css": "./3d/css/endurance-clock-3d.css",
    "./2d": "./js/endurance-clock.js",
    "./2d/css": "./css/endurance-clock.css",
    "./daylight": "./js/daylight.js",
    "./tick": "./js/tick.js",
    "./murph": "./js/murph.js",
    "./package.json": "./package.json"
  },
  "files": [
    "3d/js",
    "3d/css",
    "js",
    "css",
    "README.md"
  ],
  "peerDependencies": {
    "three": ">=0.160.0"
  },
  "peerDependenciesMeta": {
    "three": {
      "optional": true
    }
